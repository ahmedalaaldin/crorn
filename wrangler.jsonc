{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crorn-dms",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "account_id": "52b7f1b2600c3ff4726e38c956963ca4",
  // Keep the workers.dev URL alongside the custom domain.
  "workers_dev": true,
  // Custom domain: the `crorn-parked` hold on www.crorn.com has been removed,
  // so wrangler provisions the DNS record + TLS certificate on deploy.
  "routes": [
    { "pattern": "crorn.com", "custom_domain": true },
    { "pattern": "www.crorn.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "production",
    "NOTIFY_EMAIL": "ahmed@zargina.com"
  },
  // Outbound email via Email Routing's send binding. Restricted to the verified
  // destination ahmed@zargina.com (free to send to verified destinations).
  "send_email": [
    { "name": "EMAIL", "destination_address": "ahmed@zargina.com" }
  ],
  // D1 — relational metadata (documents, workflows, audit, reference data)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crorn-dms-db",
      "database_id": "cece9381-0a1b-4fa4-ac7b-92bf28fb8c48",
      "migrations_dir": "migrations"
    }
  ],
  // R2 — document file storage (revisions)
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "crorn-dms-files"
    }
  ],
  // KV — auth sessions and lightweight cache
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "2c34450104cc4e81b54aa7c307a57ff3"
    },
    {
      "binding": "CACHE",
      "id": "6163c9fccad041a3973ef67b5ab92d47"
    }
  ],
  // Daily SLA / escalation sweep (06:00 UTC)
  "triggers": {
    "crons": ["0 6 * * *"]
  }
}
