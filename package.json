{
  "name": "crorn-dms",
  "version": "0.1.0",
  "private": true,
  "description": "crorn DMS — Aconex-style construction Document Management System with workflow automation on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply crorn-dms-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply crorn-dms-db --local",
    "db:seed": "wrangler d1 execute crorn-dms-db --remote --file=migrations/0002_seed.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.103.0"
  }
}
